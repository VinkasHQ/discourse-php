{
    "name": "vinkas/discourse",
    "description": "PHP library to authenticate your forum using Discourse Connect",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vinoth Kannan",
            "email": "vinoth.kannan@vinkas.com",
            "homepage": "https://github.com/vinothkananns"
        },
        {
            "name": "Vinkas",
            "homepage": "http://vinkas.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "saloonphp/saloon": "^3.10"
	  },
    "autoload": {
        "psr-4": {
            "Vinkas\\Discourse\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "keywords": ["connect", "sso", "discourse", "vinkas"],
    "extra": {
        "branch-alias": {
            "dev-main": "2.0-dev"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "pestphp/pest": "^3.5"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
